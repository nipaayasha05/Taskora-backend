model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String?
  googleId      String?      @unique
  systemRole    SystemRole   @default(USER)
  status        UserStatus   @default(ACTIVE)
  authProvider  AuthProvider @default(CREDENTIAL)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  profile              Profile?
  createdOrganizations Organization[]
  organizationMembers  OrganizationMember[]

  invitedBy OrganizationJoinRequest[] @relation("OrganizationJoinRequestInvitedByUser")
  invitedTo OrganizationJoinRequest[] @relation("OrganizationJoinRequestInvitedToUser")

  cretedBy    Team[]
  teamMembers TeamMember[]

  createdProjects Project[] @relation("ProjectCreatedBy")

  createdById        Task[]
  createdSprints     Sprint[]
  createdSprintTeams SprintTeam[]

  createdSubTasks SubTask[] @relation("SubTaskCreator")
  assignedTo      SubTask[] @relation("SubTaskAssignee")
  clientProjects  Project[] @relation("ProjectClient")

  payments Payment[]

  attachments Attachment[]
  comments    Comment[]

  @@map("users")
}
