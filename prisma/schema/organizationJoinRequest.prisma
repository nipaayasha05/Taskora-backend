model OrganizationJoinRequest {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedToId String
  invitedTo   User   @relation("OrganizationJoinRequestInvitedToUser", fields: [invitedToId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("OrganizationJoinRequestInvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  role OrganizationRole @default(TEAM_MEMBER)

  status    OrganizationJoinRequestStatus @default(PENDING)
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  @@index([organizationId, invitedToId])
  @@map("organization_join_request")
}
